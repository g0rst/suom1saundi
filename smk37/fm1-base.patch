+#if defined BOARD_SMK37 && BOARD_SMK37
+/* LEDs on the SMK-37 (felucca-bsp boards/smk37/smk_input.h): its button LEDs are on or off (no dim layer: the
+ * FM-1's glow and mid levels light nothing, or fully), SEQ PLAY has a green and a red half (LED 16, 18); the keybed has
+ * no LEDs (what the FM-1 shows on its keys is the app's to show: on the pads, plat_smk_pad_rgb, or the screen) */
+static uint32_t smk_lit_extra;                      /* plat_smk_leds: KNOB BANK, FADER BANK, <, > */
+static uint8_t play_red;
+static void led_pos_init(void) {}
+#ifdef APP_DIM_LEVELS
+void plat_dim_ns(uint32_t ns) { (void)ns; }
+#endif
+static void smk_leds_out(uint32_t buttons)
+{
+    uint8_t nl[SMK_NLED] = {0};
+    uint32_t i;
+    for (i = 0; i < NB; i++)
+        if ((buttons >> i) & 1u)
+            nl[panel.btn[i]] = 1;
+    if ((buttons & (1u << B_PLAY | LED_PLAY_GREEN)) && play_red) {
+        nl[panel.btn[B_PLAY]] = 0;                  /* recording: SEQ PLAY's red half */
+        nl[18] = 1;
+    } else if (buttons & LED_PLAY_GREEN) {
+        nl[panel.btn[B_PLAY]] = 1;
+    }
+    for (i = SMK_KNOB_BANK; i <= SMK_RIGHT; i++)
+        if ((smk_lit_extra >> i) & 1u)
+            nl[i] = 1;
+    for (i = 0; i < SMK_NLED; i++)
+        fm1_led[i] = nl[i];
+}
+static uint32_t smk_btn_lit;
+void plat_lights(uint32_t buttons, uint32_t keys, uint32_t dim_buttons, uint32_t dim_keys, int glow)
+{
+    smk_btn_lit = buttons;
+    smk_leds_out(buttons);
+    {   /* the mirror's view, as on the FM-1 */
+        uint32_t play = 1u << B_PLAY, lit = buttons & ((1u << NB) - 1u);
+        uint32_t db = glow > 0 ? dim_buttons : 0u, dk = glow > 0 ? dim_keys : 0u;
+        mirror_leds((lit & ~play) | (buttons & (play | LED_PLAY_GREEN) ? play : 0u) | (buttons & play ? 1u << 15 : 0u),
+                    keys, (db & ((1u << NB) - 1u) & ~play) | (db & (play | LED_PLAY_GREEN) ? play : 0u), dk);
+    }
+}
+void plat_lights_mid(uint32_t buttons, uint32_t keys)   /* (no mid level: lit) */
+{
+    smk_leds_out(smk_btn_lit | buttons);
