+#if defined BOARD_SMK37 && BOARD_SMK37
+/* The SMK-37's 16 RGB pads (genkigenki/fm1-x0x lcd.c): WS2812-class LEDs on SPI1 pin group B (PC10), one SPI byte per
+ * LED bit (0xF0 = 1, 0xC0 = 0, MSB first, GRB), 250 zero bytes of reset first (~300 us: the stock firmware's 36 are too
+ * short for newer WS2812 parts, whose chain then shifts by one). A frame goes out between screen transfers (the panel's
+ * CS high), blocking for ~0.8 ms; padled_flush sends only when a colour changed. */
+#define PADLED_N 16u
+#define PADLED_LATCH 250u
+static uint8_t padled_buf[PADLED_LATCH + PADLED_N * 24u];   /* (.bss: the latch bytes stay 0) */
+static uint32_t padled_rgb[PADLED_N];
+static uint8_t padled_dirty = 1;
+/* pad (0..7 the top row, 8..15 the bottom row, left to right) -> its place in the chain (the stock table) */
+static const uint8_t PADLED_SLOT[PADLED_N] = {0, 15, 14, 13, 12, 11, 10, 9, 1, 2, 3, 4, 5, 6, 7, 8};
+
+static void padled_set(uint32_t pad, uint8_t r, uint8_t g, uint8_t b)
+{
+    uint32_t c = (uint32_t)g << 16 | (uint32_t)r << 8 | b;
+    if (pad < PADLED_N && padled_rgb[pad] != c) {
+        padled_rgb[pad] = c;
+        padled_dirty = 1;
+    }
+}
+
+static void padled_flush(void)
+{
+    uint32_t p, i;
+    if (!padled_dirty)
+        return;
+    padled_dirty = 0;
+    for (p = 0; p < PADLED_N; p++) {
+        uint8_t *o = padled_buf + PADLED_LATCH + PADLED_SLOT[p] * 24u;
+        for (i = 0; i < 24u; i++)
+            o[i] = (padled_rgb[p] >> (23u - i)) & 1u ? 0xF0u : 0xC0u;
+    }
+    lcd_sync();
+    fm1_padled_send(padled_buf, sizeof padled_buf);
+    fm1_lcd_wait();
+    fm1_padled_done();
+}
+#endif
