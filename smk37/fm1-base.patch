diff --git a/device/panel.c b/device/panel.c
index 81894ea..fe8c047 100644
--- a/device/panel.c
+++ b/device/panel.c
@@ -8,6 +8,116 @@ static const char *const B_NAME[NB] = {"FX", "SEL", "ENV", "LFO", "EDIT", "GLO",
                                         "ARP", "SEQ", "PLAY", "REC", "OCT-", "OCT+"};
 static const char *const E_NAME[NE] = {"SELECT", "ALGORITHM", "PRESETS", "KNOB 1", "KNOB 2",
                                         "KNOB 3", "KNOB 4"};
+#if defined BOARD_SMK37 && BOARD_SMK37
+/* The M-VAVE SMK-37 (felucca-bsp boards/smk37/smk_input.h button ids): its printed buttons carry the FM-1's labels
+ * (confirmed on a unit by genkigenki/fm1-x0x): FX = FX, SCALE = SEL, CHORD = ENV, NOTE REPEAT = LFO, PARA = EDIT,
+ * GLOBE = GLO, PATCH = HOME, BT = SAVE, ARP, SEQ as printed, SEQ PLAY = PLAY, SEQ REC = REC, OCTAVE- / + = OCT- / OCT+;
+ * KNOB BANK, FADER BANK, < and > are the app's (plat_smk_buttons). The knobs K1..K8 (left to right, top row first):
+ * knob[k] the encoder, kdir[k] its direction; the FM-1's roles on them while the app leaves them so (plat_smk_knobs 0):
+ * K1 MASTER, K2 SELECT, K3 ALGORITHM, K4 PRESETS, K5..K8 KNOB 1..4. HARDWARE CALIBRATION (OCTAVE- and OCTAVE+ held at
+ * power-on) teaches the eight knobs (the encoders' order is the stock table's, not yet confirmed on a unit). */
+#define PANEL_MAGIC 0x37334B53u          /* "SK37": an FM-1 table never loads here */
+#define PANEL_NKNOB 8u
+typedef struct {
+    uint32_t magic;
+    uint8_t btn[NB];             /* smk_input.h button id (0..17) per label */
+    uint8_t enc[NE];             /* encoder (0..7) per role (from knob[] below) */
+    int8_t dir[NE];              /* +1 / -1 so that clockwise is + */
+    uint8_t knob[PANEL_NKNOB];   /* K1..K8: the encoder */
+    int8_t kdir[PANEL_NKNOB];    /* K1..K8: +1 / -1 so that clockwise is + */
+} panel_t;
+panel_t panel __attribute__((section(".noinit")));
+static const char *const K_NAME[PANEL_NKNOB] = {"K1", "K2", "K3", "K4", "K5", "K6", "K7", "K8"};
+
+static const panel_t PANEL_DEFAULT = {
+    PANEL_MAGIC,
+    {14, 8, 9, 7, 13, 10, 12, 11, 6, 15, 16, 17, 4, 5},
+    {1, 2, 3, 4, 5, 6, 7},
+    {1, 1, 1, 1, 1, 1, 1},
+    {0, 1, 2, 3, 4, 5, 6, 7},
+    {1, 1, 1, 1, 1, 1, 1, 1},
+};
+
+static void panel_roles(panel_t *p)       /* the FM-1's roles from the knobs: K1 MASTER, K2..K8 */
+{
+    uint32_t i;
+    smk_master_enc = p->knob[0];
+    smk_master_dir = p->kdir[0];
+    for (i = 0; i < NE; i++) {
+        p->enc[i] = p->knob[i + 1u];
+        p->dir[i] = p->kdir[i + 1u];
+    }
+}
+
+static int panel_valid(const panel_t *p)
+{
+    uint32_t i, used = 0, ok = p->magic == PANEL_MAGIC;
+    for (i = 0; ok && i < NB; i++)
+        ok = p->btn[i] < FM1_NBTN;
+    for (i = 0; ok && i < PANEL_NKNOB; i++) {
+        ok = p->knob[i] < FM1_NENC && !((used >> p->knob[i]) & 1u) && (p->kdir[i] == 1 || p->kdir[i] == -1);
+        used |= 1u << p->knob[i];
+    }
+    return (int)ok;
+}
+
+static void panel_init(void)
+{
+    panel_t p;
+    if (plat_store_load(OBJ_PANEL, &p, sizeof p) == (int)sizeof p && panel_valid(&p))
+        panel = p;
+    if (!panel_valid(&panel))
+        panel = PANEL_DEFAULT;
+    panel_roles(&panel);
+}
+
+#define SETUP_IDLE_MS 30000u
+static void panel_setup(void)
+{
+    uint32_t i, used = 0, t0 = fm1_ms;
+    const panel_t old = panel;
+    lcd_fill(0, 0, 240, 240, C_BLACK);
+    sys_box(0, 10, 240, SYS_S, "HARDWARE CALIBRATION", C_WHITE, 1);
+    sys_box(0, 30, 240, SYS_S, "TURN EACH KNOB RIGHT", C_GRAY, 1);
+    while (fm1_in.buttons) {
+        fm1_wdt_feed();
+        if (fm1_ms - t0 > SETUP_IDLE_MS)
+            goto timeout;
+    }
+    for (i = 0; i < PANEL_NKNOB; i++) {
+        uint32_t e;
+        int32_t st = 0;
+        sys_box(0, 80, 240, SYS_S, "TURN RIGHT", C_GRAY, 1);
+        sys_box(0, 100, 240, SYS_BIG, K_NAME[i], C_WHITE, 1);
+        for (e = 0; e < FM1_NENC; e++)
+            fm1_enc_take(e);
+        t0 = fm1_ms;
+        for (;;) {
+            fm1_wdt_feed();
+            if (fm1_ms - t0 > SETUP_IDLE_MS)
+                goto timeout;
+            for (e = 0; e < FM1_NENC; e++)
+                if (!((used >> e) & 1u) && (st = fm1_enc_take(e)) != 0)
+                    break;
+            if (e < FM1_NENC)
+                break;
+        }
+        panel.knob[i] = (uint8_t)e;
+        panel.kdir[i] = (int8_t)(st > 0 ? 1 : -1);
+        used |= 1u << e;
+        fm1_delay_ms(300);
+        fm1_enc_take(e);
+    }
+    panel.magic = PANEL_MAGIC;
+    panel_roles(&panel);
+    plat_store_save(OBJ_PANEL, &panel, sizeof panel);
+    lcd_fill(0, 0, 240, 240, C_BLACK);
+    return;
+timeout:
+    panel = old;
+    lcd_fill(0, 0, 240, 240, C_BLACK);
+}
+#else
 #define PANEL_MAGIC 0x50414E35u          /* "PAN5": Felucca's layout, so its calibration stays valid */
 
